# DevMail backend environment template.
# Copy to .env (never commit) — defaults target the local development database.

# HTTP listener for the API
HTTP_ADDR=:7000

# PostgreSQL development database (user postgres, password 1508)
DATABASE_URL=postgres://postgres:1508@127.0.0.1:5432/devmail?sslmode=disable

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3001,http://127.0.0.1:8080

# Safety switch for connectivity checks. When false (default), SSRF guards reject
# loopback, link-local, multicast, metadata-service, and private destinations.
ALLOW_PRIVATE_NETWORKS=false

# Environment: development | test | production
APP_ENV=development