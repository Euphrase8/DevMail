# DevMail deployment environment. Docker Compose reads ./.env automatically.
# Copy to .env and set real values. Never commit .env (it stays untracked).

# PostgreSQL superuser password for the bundled database (required).
POSTGRES_PASSWORD=change-me

# Passphrase that encrypts provider credentials and DKIM private keys at rest
# (required). Changing it after keys exist makes those keys unreadable.
SECRET_KEY=change-me-too

APP_ENV=production

# Public origin of the web UI, used for CORS.
PUBLIC_ORIGIN=https://mail.example.com

# Mail engine adapter: "sql" deploys the bundled Postfix/Dovecot/OpenDKIM stack
# and provisions real accounts; "none" leaves records unmanaged.
MAIL_ENGINE=sql

# Mail server identity and the primary managed mail domain.
MAIL_HOSTNAME=mail.example.com
MAIL_DOMAIN=example.com

# Networks allowed to relay without authentication (loopback by default).
POSTFIX_MYNETWORKS=127.0.0.0/8

# Host port mappings (host:container). 25, 587, 465 and 993 must be reachable
# from the internet for mail to flow; 465/993 must also have valid TLS.
SMTP_PORT=25
SUBMISSION_PORT=587
SMTPS_PORT=465
IMAPS_PORT=993