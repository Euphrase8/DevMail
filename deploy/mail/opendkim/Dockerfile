# DevMail OpenDKIM container.
#
# Signs outbound mail for domains managed by DevMail. The DKIM private keys are
# generated by the DevMail API, stored encrypted at rest, and exported here by
# the devmail-tools binary (built from this repository) so they never leave the
# deployment. Keys and the KeyTable/SigningTable are written to the dkim-keys
# volume and kept in sync with the database.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /devmail-tools ./cmd/tools

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends opendkim \
 && rm -rf /var/lib/apt/lists/*

COPY deploy/mail/opendkim/opendkim.conf /etc/opendkim/opendkim.conf
COPY deploy/mail/opendkim/init.sh /usr/local/bin/dkim-init
RUN chmod +x /usr/local/bin/dkim-init \
 && mkdir -p /etc/opendkim/keys /run/opendkim \
 && chown -R opendkim:opendkim /etc/opendkim/keys /run/opendkim
COPY --from=build /devmail-tools /usr/local/bin/devmail-tools

EXPOSE 8891
ENTRYPOINT ["/usr/local/bin/dkim-init"]